# PostgreSQL environment variables
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=djangosite

# pgAdmin default credentials
PGADMIN_DEFAULT_EMAIL=pgadmin4@pgadmin.org
PGADMIN_DEFAULT_PASSWORD=admin

# Django settings
DJANGO_DEBUG=true
# WARNING: dev-only default — set a strong random key for any real deployment
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Custom ports (override as needed)
DJANGO_PORT=8000
POSTGRES_PORT=6543
PGADMIN_PORT=5555
